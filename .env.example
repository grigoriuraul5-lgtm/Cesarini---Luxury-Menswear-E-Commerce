# Notificări comenzi către atelier (toate opționale; canalele fără chei sunt sărite)
# Copiază în .env.local și completează. NU publica acest fișier cu valori reale.

# Webhook generic (Make / Zapier / n8n / CRM) — primește payload-ul JSON complet
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta). Template-ul trebuie aprobat în Meta, limba „ro”, 5 variabile.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=40723424929
WHATSAPP_TEMPLATE=comanda_noua_atelier
WHATSAPP_API_VERSION=v21.0

# Telegram Bot (@BotFather → token; chat_id = grupul atelierului)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email prin Resend (destinatarul poate fi o adresă Gmail)
RESEND_API_KEY=
ORDER_EMAIL_TO=contact@cesarini.ro
ORDER_EMAIL_FROM=Cesarini Comenzi <comenzi@cesarini.ro>
